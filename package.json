{
  "name": "@stigg/agent-sdk-js",
  "version": "0.2.0",
  "private": true,
  "description": "Stigg agent SDK (JS) - run-lifecycle governance for agentic stacks, with examples per layer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stiggio/stigg-agent-sdk-ts.git"
  },
  "main": "src/index.ts",
  "typings": "src/index.ts",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "yarn test:repo && tsx --test test/*.test.ts",
    "test:repo": "tsx --test tools/repo-tests/*.test.ts",
    "example-setup": "tsx examples/shared/setup-governance.ts",
    "example-client": "tsx examples/client/anthropic.ts",
    "example-client-anthropic": "tsx examples/client/anthropic.ts",
    "example-client-openai": "tsx examples/client/openai.ts",
    "example-client-gemini": "tsx examples/client/gemini.ts",
    "example-client-groq": "tsx examples/client/groq.ts",
    "example-client-mistral": "tsx examples/client/mistral.ts",
    "example-client-ollama": "tsx examples/client/ollama.ts",
    "example-client-openrouter": "tsx examples/client/openrouter.ts",
    "example-client-litellm": "tsx examples/client/litellm.ts",
    "example-client-databricks": "tsx examples/client/databricks.ts",
    "example-client-typesafe": "tsx examples/client/typesafe.ts",
    "example-two-agents": "tsx examples/client/two-agents.ts",
    "example-gateway": "tsx examples/gateway/openrouter.ts",
    "example-gateway-openrouter": "tsx examples/gateway/openrouter.ts",
    "example-gateway-litellm": "tsx examples/gateway/litellm.ts",
    "example-gateway-cloudflare": "tsx examples/gateway/cloudflare.ts",
    "example-gateway-bedrock": "tsx examples/gateway/bedrock.ts",
    "example-gateway-databricks": "tsx examples/gateway/databricks.ts"
  },
  "dependencies": {
    "@stigg/node-server-sdk": "^6.1.0",
    "@stigg/typescript": "0.1.0-beta.55",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1150.0",
    "@databricks/sdk-modelservingquery": "0.25.0",
    "@eslint/js": "^10.0.1",
    "@google/genai": "^2.28.0",
    "@mistralai/mistralai": "^2.7.0",
    "@openrouter/sdk": "^1.4.25",
    "@types/node": "^22.18.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "cloudflare": "^7.3.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "groq-sdk": "^1.6.0",
    "ollama": "^0.6.4",
    "openai": "^7.13.0",
    "prettier": "^3.8.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0"
  }
}
