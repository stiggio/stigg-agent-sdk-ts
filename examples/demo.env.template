# Fixtures for the agent-sdk examples - the committed reference copy.
#
# `demo.env` itself is git-ignored, exactly like `.env`: it is yours to point at whatever tenant
# you are testing against. Copy this file to `demo.env` to change any of it.
#
# You do not have to: every value below is also the default compiled into the examples, so they
# run on a fresh clone with no `demo.env` present at all - BUT ONLY AGAINST THE MOCK. Once
# STIGG_SERVER_API_KEY is set these defaults stop applying: a guessed `customer-acme` in an environment
# you can actually write to is either another tenant's data or a customer nobody asked for.
#
# So each variable has three states, because "fresh clone" and "I want none of this" are
# different things and an absent variable cannot mean both:
#
#   absent             the default below, offline. With a real key: unset.
#   set                that value, always.
#   present but blank  unset, deliberately - in BOTH modes. This is how the degraded paths
#                      (no agent, no team, no entitlement) stay runnable against the mock.
#
# Everything here is demo scaffolding, NOT configuration you would carry into an application.
# A real app knows its tenant from the request it is serving, its agent from the code that spawned
# it, and what it gates on from its own pricing - none of it is ever read from an env file. The
# SDK's own settings are arguments, not variables:
#
#   new StiggAgentSDK(apiKey, { baseUrl, cache, client, timeoutMs, logger, onError })
#   stigg.wrap(client, { stiggContext: { entitlement, usageMapper, ingestMode, eventName } })
#
# Only credentials and endpoints live in ../.env (start from ../.env.template).
#
# `.env` is loaded first and never overwritten, so you can also override any of these from there.

# --- Who the demo pretends to be --------------------------------------------------------------
# The tenant every example bills against. Must exist in the Stigg environment your key points at;
# `yarn example-setup` creates it if it does not. The one
# fixture with no meaningful absence: with a real key and this unset, the examples stop rather
# than invent a tenant.
AGENT_SDK_DEMO_CUSTOMER_ID=customer-acme

# The parent entity, so a denial can demonstrate the ancestor rule: an agent inside its own budget
# can still be refused by the team above it. Blank it and the agents are roots instead - nothing
# above them binds. `two-agents` is that rule and will tell you it needs this one.
AGENT_SDK_DEMO_TEAM_ID=team-research

# Base agent id. Each client example appends its vendor (`-anthropic`, `-openai`, `-openrouter`),
# so running one example never spends another's budget.
#
# Blank it to run with NO AGENT AT ALL: checks and usage then land on the customer's own pool
# instead of a per-agent budget. There is no separate flag for this - an agent id naming no agent
# and a flag saying there is no agent would only be two places for one fact to disagree.
AGENT_SDK_DEMO_AGENT_ID=agent-support-bot
# The entity type agents are provisioned as, and the key it identifies them under. A call
# attributes by the key, so a type declaring a different one resolves nothing and the spend lands
# on the customer - looking exactly like a call that was never governed.
#
# BOTH OR NEITHER. The SDK has no default for either half, precisely because that failure is
# silent; the examples refuse a half-set pair rather than guess. Blank both to run with no agent.
AGENT_SDK_DEMO_ENTITY_TYPE_ID=agent
AGENT_SDK_DEMO_ATTRIBUTION_KEY=agentId

# --- Running without accounts -----------------------------------------------------------------
# Every example falls back to a built-in mock whenever the matching API key is blank. Set this to
# 1 to force the mocks even when keys ARE set - useful when a key is valid but the account has no
# credits. Leave blank to use the real APIs whenever a key is present.
AGENT_SDK_OFFLINE=

# Mock-only, for exercising the failure paths:
#   1 => the governance check returns 503, so `checkErrorAction` decides the outcome. That is an
#        SDK option and not a variable: it defaults to `allow` - a soft limit, so an outage does
#        not take the application down - and `{ checkErrorAction: 'deny' }` mirrors the server.
AGENT_SDK_DEMO_MOCK_GOVERNANCE_FAIL=

# --- What the examples gate and meter against -------------------------------------------------
# A real application decides these in code; here they are variables so you can play with the
# examples without editing them.

# What the budget is measured against: a credit currency OR a metered feature, never both.
#
# Naming NEITHER is legal and means the calls are UNGATED: `stiggContext.entitlement` is itself
# the enforcement switch, so with none no check leaves the process, nothing can be refused, and
# metering carries on unchanged. Offline a currency stands in so the mock has a budget to refuse
# with - blank both to see the ungated path against it. `two-agents` and the gateway examples
# decline to run ungated, since a budget draining is the whole thing they demonstrate.
AGENT_SDK_DEMO_CURRENCY_ID=credits
AGENT_SDK_DEMO_FEATURE_ID=

# Raw-events meters are matched by EVENT NAME, not by feature id - so if the target above is
# backed by one, set its event name here. Left blank, a gated call is reported under the vendor
# method that produced the usage (`anthropic.messages.create`), which is what a meter should
# filter on. Read the feature's `meter.filters` for the name it expects.
AGENT_SDK_DEMO_EVENT_NAME=

# Not variables: how many tokens make one unit, and which ingest API to report through, are both
# decisions an example makes in code. `two-agents` prices with `unitsPerTokens(id, 1_000)` and
# reports `sync` because watching a budget fall is its whole subject; the chat takes the default
# `async`. A variable for either would only let you break the example it belongs to.
